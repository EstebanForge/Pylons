{
  "$id": "https://pylons.local/schemas/vocabulary.json",
  "version": 1,
  "title": "Pylons closed frontmatter vocabulary",
  "description": "The closed value sets Pylons frontmatter fields accept. Status values are enforced by the lint engine (PYLON008); the other sets are conventions, with PYLON041 validating the post-mortem tokens.",
  "status": {
    "proposals": [
      "proposed"
    ],
    "plans": [
      "proposed",
      "accepted",
      "in-progress",
      "paused",
      "shipped",
      "abandoned"
    ],
    "conventions": [
      "proposed",
      "accepted",
      "enforced",
      "superseded"
    ],
    "decisions": [
      "proposed",
      "accepted",
      "superseded",
      "deprecated"
    ],
    "investigations": [
      "active",
      "resolved",
