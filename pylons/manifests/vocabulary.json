  "protected_owners": {
    "release-bot": "forced",
    "vendored": "forced",
    "generated": "forced",
    "human-only": "forced",
    "ask-first": "advisory"
  },
  "closed_sets": {
    "level": {
      "documents": [
        "conventions"
      ],
      "values": [
        "MUST",
        "SHOULD"
      ],
      "enforced_by": null
    },
    "ai_authored_contributed": {
      "documents": [
        "quirks"
      ],
      "values": [
        "yes",
        "no",
        "unknown"
      ],
      "enforced_by": "PYLON041"
    },
    "volume_pressure": {
      "documents": [
