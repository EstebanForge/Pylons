# Build artifact: cd cli && go build -o ../bin/pylon ./cmd/pylon
/bin/*
!/bin/AGENTS.md
!/bin/THIRD_PARTY_NOTICES

# Go test leftovers
/cli/*.test
/cli/coverage.*

# Generated by `pylon review-brief`; pass --stdout to keep it out of the tree
/.pylon-review-brief.md

# macOS junk; AppleDouble files recur whenever the tree crosses a Mac
.DS_Store
._*
.AppleDouble/

# Editor junk
.idea/
*.swp
*~

# local release artifacts
/dist/
