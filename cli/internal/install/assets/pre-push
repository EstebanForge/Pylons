#!/usr/bin/env bash
# Pylons pre-push gate shim: all gate logic lives in the compiled
# engine (pylon gate pre-push). Enable with: pylon install
# (or git config core.hooksPath .githooks). Opt out: PYLON_HOOKS_OPTIONAL=1

set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

find_bin() {
    local cand
    for cand in "$DIR/bin/pylon" "$DIR/bin/pylon.exe" "$DIR/pylons/bin/pylon"; do
        [[ -x "$cand" ]] && { printf '%s\n' "$cand"; return 0; }
    done
    command -v pylon 2>/dev/null
}

if ! BIN="$(find_bin)"; then
    if [[ "${PYLON_HOOKS_OPTIONAL:-0}" == "1" ]]; then
        echo "pylon: PYLON_HOOKS_OPTIONAL=1; skipping pre-push gate" >&2
        exit 0
    fi
    echo "pylon: no pylon binary found (build: cd cli && go build -o ../pylons/bin/pylon ./cmd/pylon; opt out: PYLON_HOOKS_OPTIONAL=1)" >&2
    exit 1
fi

exec "$BIN" gate pre-push
